# Порти
CRM_PORT=3000                 # адмінка + API
CRM_POSTBACK_PORT=3001        # окремий сервіс постбеків і редіректів

# Ключ шифрування секретів (паролі акаунтів, проксі, пошт). 32 байти у hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRM_SECRET_KEY=

# Шлях до бази (за замовчуванням ./data/crm.db)
CRM_DB=./data/crm.db

# Стартовий власник (створюється командою npm run seed)
CRM_ADMIN_EMAIL=owner@gennect.local
CRM_ADMIN_PASSWORD=

# Сесії
CRM_SESSION_DAYS=7
CRM_SECURE_COOKIE=1           # 1 у проді (HTTPS)

# Telegram-сповіщення (необовʼязково)
CRM_TELEGRAM_TOKEN=
CRM_TELEGRAM_CHAT_ID=

# Період фонових перевірок (мс)
CRM_TICK_MS=900000
